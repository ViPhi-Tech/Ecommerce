{
  "overrides": [
    {
      "files": "*.html",
      "options": {
        "parser": "angular",

        "arrowParens": "avoid"
      }
    }
  ],
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": true,
  "semi": true,
  "arrowParens": "avoid",
  "trailingComma": "es5",
  "bracketSameLine": false,
  "printWidth": 80
}
