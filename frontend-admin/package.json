{
  "name": "sellup",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve --configuration development",
    "build": "node --max-old-space-size=4096 ./node_modules/@angular/cli/bin/ng build --configuration production && node scripts/inject-version.js",
    "build:dev": "node --max-old-space-size=4096 ./node_modules/@angular/cli/bin/ng build --configuration development",
    "watch": "node --max-old-space-size=4096 ./node_modules/@angular/cli/bin/ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "formatar": "prettier --write src",
    "electron": "ng build --base-href ./ && electron .",
    "dist": "ng build --base-href ./ && electron-builder",
    "generate-icons": "node scripts/generate-icons.js",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,scss,html}": [
      "prettier --write",
      "ng lint"
    ]
  },
  "private": true,
  "browser": {
    "timers": false
  },
  "dependencies": {
    "@angular/animations": "^21.1.5",
    "@angular/cdk": "^21.1.5",
    "@angular/common": "^21.1.5",
    "@angular/compiler": "^21.1.5",
    "@angular/core": "^21.1.5",
    "@angular/forms": "^21.1.5",
    "@angular/platform-browser": "^21.1.5",
    "@angular/platform-browser-dynamic": "^21.1.5",
    "@angular/router": "^21.1.5",
    "@angular/service-worker": "^21.1.5",
    "@floating-ui/dom": "^1.7.5",
    "@ng-icons/core": "^31.2.0",
    "@ng-icons/heroicons": "^31.2.0",
    "@ng-icons/lucide": "^31.2.0",
    "@ng-icons/material-icons": "^31.2.0",
    "@primeng/themes": "^19.0.10",
    "@primeuix/themes": "^1.2.5",
    "@types/file-saver": "^2.0.7",
    "dayjs": "^1.11.13",
    "echarts": "^6.0.0",
    "fast-xml-parser": "^5.2.5",
    "file-saver": "^2.0.5",
    "jwt-decode": "^4.0.0",
    "ngx-echarts": "^21.0.0",
    "ngx-float-ui": "^21.0.1",
    "ngx-mask": "^21.0.1",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.1",
    "rxjs": "~7.8.0",
    "tailwindcss-primeui": "^0.6.1",
    "tslib": "^2.3.0",
    "tw-bootstrap-grid-optimizer": "^1.0.2",
    "xlsx": "^0.18.5",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.5",
    "@angular/cli": "^21.1.5",
    "@angular/compiler-cli": "^21.1.5",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "^21.2.0",
    "autoprefixer": "^10.4.21",
    "electron": "^36.4.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.1",
    "husky": "^9.1.7",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^16.2.3",
    "postcss": "^8.5.6",
    "prettier": "3.5.3",
    "rimraf": "^6.0.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.56.1"
  }
}