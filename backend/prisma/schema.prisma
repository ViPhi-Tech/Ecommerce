generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Login {
  id             Int     @id @default(autoincrement())
  email          String  @unique
  googleId       String? @unique
  hashedPassword String?

  user   User?
  client Client?
}

model User {
  id       Int     @id @default(autoincrement())
  fullName String?
  isActive Boolean @default(true)

  loginId   Int? @unique
  companyId Int?

  company Company? @relation(fields: [companyId], references: [id])
  login   Login?   @relation(fields: [loginId], references: [id])

  address Address?
}

model Client {
  id       Int     @id @default(autoincrement())
  fullName String?
  document String? @unique
  email    String? @unique
  phone    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loginId Int?   @unique
  login   Login? @relation(fields: [loginId], references: [id])

  sales   Sale[]
  address Address?
}

model Company {
  id       Int     @id @default(autoincrement())
  fullName String
  document String
  isActive Boolean @default(true)

  users    User[]
  products Product[]
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  sku         String  @unique
  price       Float
  cost        Float?
  quantity    Int     @default(0)
  ean         String  @default("0")
  isActive    Boolean @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId   Int?
  company     Company? @relation(fields: [companyId], references: [id])

  stock       Stock?   @relation("ProductStock") // Definindo a relação no Product
  saleItems   SaleItem[]

  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id]) // Definindo a relação com Category
}

model Sale {
  id        Int      @id @default(autoincrement())
  total     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientId Int?
  client   Client? @relation(fields: [clientId], references: [id])

  items SaleItem[]
}

model SaleItem {
  id        Int   @id @default(autoincrement())
  saleId    Int
  productId Int
  quantity  Int
  price     Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Partner {
  id          Int         @id @default(autoincrement())
  name        String
  email       String      @unique
  phone       String?
  companyName String?
  document    String?
  type        PartnerType @default(RESELLER)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  address Address?
}

enum PartnerType {
  RESELLER
  DISTRIBUTOR
  AFFILIATE
  AGENT
  OTHER
}

model Address {
  id         Int      @id @default(autoincrement())
  street     String
  number     String
  city       String
  state      String
  zipCode    String
  complement String?
  partner    Partner? @relation(fields: [partnerId], references: [id])
  partnerId  Int?     @unique

  client   Client? @relation(fields: [clientId], references: [id])
  clientId Int?    @unique

  user   User? @relation(fields: [userId], references: [id])
  userId Int?  @unique
}

model Stock {
  id        Int      @id @default(autoincrement())
  productId Int      @unique // Chave única para cada produto (garante relação 1:1)
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product  @relation("ProductStock", fields: [productId], references: [id]) // Relacionando com o Product
  movements StockMovement[] // Relacionamento 1:N com StockMovement

}

model StockMovement {
  id        Int          @id @default(autoincrement()) // Identificador único da movimentação
  stockId   Int // Chave estrangeira para o estoque
  type      MovementType // Tipo de movimentação (entrada ou saída)
  quantity  Int // Quantidade movimentada
  createdAt DateTime     @default(now()) // Data da movimentação
  updatedAt DateTime     @updatedAt // Data da última atualização da movimentação

  stock     Stock        @relation(fields: [stockId], references: [id]) // Relaciona com o modelo Stock
}

enum MovementType {
  IN
  OUT
}



model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]
}