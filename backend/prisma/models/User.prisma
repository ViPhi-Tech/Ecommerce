model Login {
  id                          Int       @id @default(autoincrement())
  email                       String    @unique
  googleId                    String?   @unique
  hashedPassword              String?
  createPasswordToken         String?   @unique
  createPasswordTokenExpiresAt DateTime?
  client                      Client?
  user                        User?
}

model User {
  id             Int             @id @default(autoincrement())
  fullName       String?
  isActive       Boolean         @default(true)
  loginId        Int?            @unique
  companyId      Int?
  address        Address?
  stockMovements StockMovement[]
  schedules      Schedule[]
  company        Company?        @relation(fields: [companyId], references: [id])
  login          Login?          @relation(fields: [loginId], references: [id])
  roles          UserRole[]
}

model Address {
  id         Int      @id @default(autoincrement())
  street     String
  number     String
  city       String
  state      String
  zipCode    String
  complement String?
  partnerId  Int?     @unique
  clientId   Int?     @unique
  userId     Int?     @unique
  client     Client?  @relation(fields: [clientId], references: [id])
  partner    Partner? @relation(fields: [partnerId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])
}

model Role {
  nome      String
  uuid      String     @id @default(uuid())
  userRoles UserRole[]
}

model UserRole {
  id     Int    @id @default(autoincrement())
  userId Int
  roleId String
  role   Role   @relation(fields: [roleId], references: [uuid])
  user   User   @relation(fields: [userId], references: [id])
}
