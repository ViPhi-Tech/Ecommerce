model Product {
  id               Int           @id @default(autoincrement())
  name             String
  description      String?
  sku              String        @unique
  cost             Float?
  quantity         Int           @default(0)
  ean              String        @default("0")
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  companyId        Int?
  categoryId       Int?
  finalPrice       Float         @default(0)
  image            String?
  initialPrice     Float         @default(0)
  shortDescription String?
  brandId          Int?
  icms             Float?        // Valor unitário do ICMS (editável)
  st               Float?        // Valor unitário da ST - Substituição Tributária (editável)
  invoices         InvoiceItem[]
  orderItems       OrderItem[]
  brand            Brand?        @relation(fields: [brandId], references: [id])
  category         Category?     @relation(fields: [categoryId], references: [id])
  company          Company?      @relation(fields: [companyId], references: [id])
  stock            Stock?        @relation("ProductStock")
  purchaseInvoiceItems PurchaseInvoiceItem[]
}

model Partner {
  id          Int         @id @default(autoincrement())
  name        String
  email       String      @unique
  phone       String?
  companyName String?
  document    String?
  type        PartnerType @default(RESELLER)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  address     Address?
}

model Stock {
  id        Int             @id @default(autoincrement())
  productId Int             @unique
  quantity  Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  product   Product         @relation("ProductStock", fields: [productId], references: [id])
  movements StockMovement[]
}

model StockMovement {
  id            Int          @id @default(autoincrement())
  stockId       Int
  type          MovementType
  quantity      Int
  
  unitCost      Float?       // Valor de compra unitário
  invoiceNumber String?      // Número da nota fiscal (Ex: "NF-1234")
  icms          Float?       // Valor unitário do ICMS na hora da nota
  st            Float?       // Valor unitário da ST (Substituição Tributária) na hora da nota

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  userId        Int?
  
  stock         Stock        @relation(fields: [stockId], references: [id])
  user          User?        @relation(fields: [userId], references: [id])
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isActive  Boolean?  @default(true)
  products  Product[]
}

enum PartnerType {
  RESELLER
  DISTRIBUTOR
  AFFILIATE
  AGENT
  OTHER
}

enum MovementType {
  IN
  OUT
}
