model Payment {
  id        Int      @id @default(autoincrement())
  value     Float
  typeId    String      
  statusId  String      
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order         @relation(fields: [orderId], references: [id])
  orderId Int
  type    PaymentType  @relation(fields: [typeId], references: [name])
  status  PaymentStatus @relation(fields: [statusId], references: [name])
}

model PaymentType {
  name      String    @id
  label     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  payments Payment[]
}

model PaymentStatus {
  name      String   @id
  label     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]
}
