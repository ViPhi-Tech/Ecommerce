model Payment {
  id        Int           @id @default(autoincrement())
  value     Float
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  orderId   Int
  statusId  String
  typeId    String
  order     Order         @relation(fields: [orderId], references: [id])
  status    PaymentStatus @relation(fields: [statusId], references: [name])
  type      PaymentType   @relation(fields: [typeId], references: [name])
}

model PaymentType {
  name      String    @id
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  label     String
  payments  Payment[]
}

model PaymentStatus {
  name      String    @id
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  label     String
  payments  Payment[]
}
