model Payment {
  id        Int             @id @default(autoincrement())
  value     Float
  type      PaymentType[]
  status    PaymentStatus[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  order   Order @relation(fields: [orderId], references: [id])
  orderId Int
}

model PaymentType {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]
}

model PaymentStatus {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]
}
