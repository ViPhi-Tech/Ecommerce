model AccountsPayable {
  id                Int       @id @default(autoincrement())
  uuid              String    @unique @default(uuid())
  supplierId        Int
  originalDueDate   DateTime
  issueDate         DateTime
  dueDate           DateTime
  competenceDate    DateTime?
  amount            Float
  recurringPurchase Boolean   @default(false)
  description       String
  status            String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  supplier          Supplier  @relation("SupplierToPayables", fields: [supplierId], references: [id])
}
