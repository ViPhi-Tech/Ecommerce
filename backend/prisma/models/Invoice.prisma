model Invoice {
  number      String?
  series      String?
  status      String
  issueDate   DateTime
  dueDate     DateTime?
  totalAmount Float
  taxAmount   Float?
  clientId    Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  id          Int           @id @default(autoincrement())
  external_id String        @unique @default(uuid())
  orderId     Int?
  client      Client?       @relation(fields: [clientId], references: [id])
  order       Order?        @relation(fields: [orderId], references: [id])
  items       InvoiceItem[]
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  productId   Int
  quantity    Int
  price       Float
  totalAmount Float
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  product     Product @relation(fields: [productId], references: [id])
}



model PurchaseInvoice {
  id             Int      @id @default(autoincrement())
  accessKey      String   @unique // chNFe
  number         String
  series         String
  model          Int
  issueDate      DateTime
  entryDate      DateTime
  totalAmount    Decimal  @db.Decimal(14,2)
  totalTax       Decimal  @db.Decimal(14,2)

  xmlRaw         Json     // XML inteiro convertido pra JSON
  protocol       Json     // protNFe.infProt

  supplierId     Int
  supplier       Supplier @relation(fields: [supplierId], references: [id])

  items          PurchaseInvoiceItem[]

  createdAt      DateTime @default(now())
}


model PurchaseInvoiceItem {
  id                 Int     @id @default(autoincrement())
  purchaseInvoiceId  Int
  productId          Int?

  description        String
  ncm                String
  cfop               String
  quantity           Decimal @db.Decimal(14,4)
  unitPrice          Decimal @db.Decimal(14,4)
  totalAmount        Decimal @db.Decimal(14,2)

  taxData            Json    // imposto inteiro do item

  purchaseInvoice    PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id])
  product             Product?       @relation(fields: [productId], references: [id])
}