model Supplier {
  id            String   @id @default(uuid())
  tradeName     String   // Nome fantasia
  legalName     String   // Razão social
  cnpj          String   @unique
  address       String
  email         String?  // Optional
  phone         String?  // Optional
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}