model Supplier {
  tradeName       String
  legalName       String
  cnpj            String            @unique
  address         String
  email           String?
  phone           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  uuid            String            @unique @default(uuid())
  id              Int               @id @default(autoincrement())
  accountsPayable AccountsPayable[] @relation("SupplierToPayables")
}
